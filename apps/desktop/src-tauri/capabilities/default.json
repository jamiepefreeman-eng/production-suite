{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, module pop-outs and presentation outputs",
  "windows": ["main", "module-*", "output-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "dialog:default"
  ]
}
